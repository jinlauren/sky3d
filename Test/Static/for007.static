 &files wffile='Pb208' /
 &force name='Sly5', pairing='NONE' /
 &main mprint=10,mplot=0,
  mrest=500,writeselect='r',
  imode=1,tfft=T,nof=0 /
 &grid nx=24,ny=24,nz=24,dx=1,dy=1,dz=1,
	periodic=F /
 &static nprot=82, nneut=126, 
  radinx=3.1,radiny=3.1,radinz=3.1,
  x0dmp=0.40,e0dmp=100.0,tdiag=T,tlarge=F,
  maxiter=2000,serr=1D-5 /
